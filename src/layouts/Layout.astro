---
import Header from '../components/Header.astro';
import NavTabs from '../components/NavTabs.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import SearchModal from '../components/SearchModal.astro';
import SEOHead from '../components/SEOHead.astro';
import { getConfigFile } from '../utils/config';
import { createLink } from '../utils/url';
import { getI18nConfig, getLocaleFromPath, isRTL } from '../utils/i18n';
import ScrollToTop from '../components/ScrollToTop.astro';
import type { SEOFrontmatter } from '../types/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showSidebar?: boolean;
  frontmatter?: SEOFrontmatter;
  breadcrumbs?: Array<{ name: string; href?: string }>;
  lang?: string;
}

const { title, description, showSidebar = true, frontmatter, breadcrumbs } = Astro.props;
const config = await getConfigFile();
const currentPath = Astro.url.pathname;

// Get i18n configuration
const i18nConfig = await getI18nConfig();
const detectedLocale = getLocaleFromPath(currentPath, i18nConfig.locales);
const currentLocale = Astro.props.lang || detectedLocale || i18nConfig.defaultLocale;
const isRtl = isRTL(currentLocale);

// Announcement & tabs config
const announcement = config.announcement;
const showAnnouncement = announcement?.enabled && announcement?.text;
const navTabs = config.navigation.navbar.tabs;
const hasTabs = navTabs && navTabs.length > 0;

// Theme configuration
const themeMode = config.theme?.mode || 'auto';
const defaultDark = config.theme?.defaultDark ?? true;
const initialClass = themeMode === 'light' ? 'light'
                   : themeMode === 'dark' ? 'dark'
                   : defaultDark ? 'dark' : 'light';
const headTags = config.integrations?.headTags || [];

// Font configuration
const fonts = config.branding?.fonts;
const headingFont = fonts?.heading || 'Inter';
const bodyFont = fonts?.body || 'Inter';
const codeFont = fonts?.code || 'Fira Code';

// Build Google Fonts URL dynamically
const fontFamilies: string[] = [];

// Body font (Inter needs special opsz axis)
if (bodyFont === 'Inter') {
  fontFamilies.push('Inter:opsz,wght@14..32,400..700');
} else {
  fontFamilies.push(`${bodyFont.replace(/ /g, '+')}:wght@400;500;600;700`);
}

// Heading font (skip if same as body)
if (headingFont !== bodyFont) {
  fontFamilies.push(`${headingFont.replace(/ /g, '+')}:wght@600;700;800`);
}

// Code font
fontFamilies.push(`${codeFont.replace(/ /g, '+')}:wght@400;500;600`);

const googleFontsUrl = `https://fonts.googleapis.com/css2?${fontFamilies.map(f => `family=${f}`).join('&')}&display=swap`;

// Build inline style overrides for non-default fonts
const fontOverrides: string[] = [];
if (bodyFont !== 'Inter') {
  fontOverrides.push(`--font-sans: '${bodyFont}', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif !important;`);
}
if (headingFont !== 'Inter') {
  fontOverrides.push(`--font-heading: '${headingFont}', '${bodyFont}', system-ui, sans-serif !important;`);
}
if (codeFont !== 'Fira Code') {
  fontOverrides.push(`--font-mono: '${codeFont}', 'JetBrains Mono', 'SF Mono', Monaco, Consolas, monospace !important;`);
}
const fontOverrideStyle = fontOverrides.length > 0 ? `:root { ${fontOverrides.join(' ')} }` : '';
---

<!doctype html>
<html lang={currentLocale} dir={isRtl ? 'rtl' : 'ltr'} class={initialClass} data-theme-mode={themeMode} data-has-tabs={hasTabs ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEOHead
      title={title}
      description={description}
      frontmatter={frontmatter}
      config={config}
      currentPath={currentPath}
      breadcrumbs={breadcrumbs}
    />

    <link rel="icon" href={createLink(config.branding.favicon)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={googleFontsUrl} rel="stylesheet" />

    {fontOverrideStyle && <style set:html={fontOverrideStyle} />}

    <meta name="generator" content={Astro.generator} />

    {headTags.map((ht) => {
      if (ht.tag === 'meta') return <meta {...ht.attributes} />;
      if (ht.tag === 'link') return <link {...ht.attributes} />;
      if (ht.tag === 'script') return <script is:inline {...ht.attributes} set:html={ht.content || ''} />;
      if (ht.tag === 'style') return <style set:html={ht.content || ''} />;
      return null;
    })}

    <!-- Theme initialization -->
    <script is:inline>
      (function() {
        var html = document.documentElement;
        var mode = html.getAttribute('data-theme-mode') || 'auto';
        if (mode === 'light') { html.className = html.className.replace('dark','').replace('light','') + ' light'; return; }
        if (mode === 'dark') { html.className = html.className.replace('light','').replace('dark','') + ' dark'; return; }
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          html.classList.remove('light', 'dark');
          html.classList.add(saved);
          return;
        }
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        html.classList.remove('light', 'dark');
        html.classList.add(prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    {showAnnouncement && <AnnouncementBar config={announcement} />}
    <Header />
    {hasTabs && <NavTabs tabs={navTabs} />}
    <MobileNav />
    <SearchModal />

    <div class={showSidebar ? "layout-container" : ""}>
      {showSidebar && <Sidebar />}
      <slot />
    </div>

    <style is:global>
      @reference '../styles/global.css';

      .skip-to-content {
        @apply fixed top-0 left-1/2 -translate-x-1/2 -translate-y-full z-[100];
        @apply px-4 py-2 text-sm font-medium rounded-b-lg;
        @apply bg-primary-500 text-white;
        @apply focus:translate-y-0 focus:outline-none;
        @apply transition-transform duration-200;
      }

      code, pre {
        font-family: var(--font-mono) !important;
      }

      /* Dynamic header height based on tabs */
      html[data-has-tabs] .sidebar {
        top: 7rem;
        height: calc(100vh - 7rem);
      }

      html[data-has-tabs] .toc {
        top: 7rem;
        height: calc(100vh - 7rem);
      }

      html[data-has-tabs] .main-content {
        padding-top: 7rem;
      }
    </style>
    <ScrollToTop />
  </body>
</html>

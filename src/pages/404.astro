---
import Layout from '../layouts/Layout.astro';
import { getConfigFile } from '../utils/config';
import { createLink } from '../utils/url';

const config = await getConfigFile();
const siteName = config.metadata?.name || 'Documentation';

// Find first docs link from sidebar
let docsHref = '/';
const sidebar = config.navigation?.sidebar;
if (sidebar?.length) {
  for (const group of sidebar) {
    if (group.items?.length) {
      const first = group.items[0];
      docsHref = createLink(first.href || first.slug || '/');
      break;
    }
  }
}
---

<Layout title="Page not found" showSidebar={false}>
  <main id="main-content" class="error-page">
    <div class="error-container">
      <p class="error-code">404</p>
      <h1 class="error-title">Page not found</h1>
      <p class="error-description">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="error-actions">
        <button id="search-404" class="error-search-btn" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
          Search {siteName}
        </button>
        <a href={docsHref} class="error-docs-link">
          Go to docs
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.getElementById('search-404')?.addEventListener('click', () => {
    const win = window as any;
    if (typeof win.openSearchModal === 'function') {
      win.openSearchModal();
    }
  });
</script>

<style>
  @reference "../styles/global.css";

  .error-page {
    @apply flex items-center justify-center min-h-[80vh] px-4;
  }

  .error-container {
    @apply text-center max-w-md;
  }

  .error-code {
    @apply text-8xl font-bold text-primary-500/20 leading-none select-none;
  }

  .error-title {
    @apply text-2xl font-medium text-foreground mt-2 mb-3;
  }

  .error-description {
    @apply text-muted-foreground text-sm mb-8;
  }

  .error-actions {
    @apply flex items-center justify-center gap-3 flex-wrap;
  }

  .error-search-btn {
    @apply inline-flex items-center gap-2 px-4 py-2 text-sm font-medium;
    @apply bg-primary-500 text-white rounded-lg;
    @apply hover:bg-primary-600 transition-colors cursor-pointer;
  }

  .error-docs-link {
    @apply inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium;
    @apply text-muted-foreground rounded-lg border border-border;
    @apply hover:text-foreground hover:border-foreground/20 transition-colors;
  }
</style>

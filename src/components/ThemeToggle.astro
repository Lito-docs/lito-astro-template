---
/**
 * ThemeToggle - Dark/Light theme switcher
 * Persists preference to localStorage
 */
import Icon from './Icon.astro';
import { getConfigFile } from '../utils/config';

const config = await getConfigFile();
const themeMode = config.theme?.mode || 'auto';
const shouldHide = config.theme?.hideToggle || themeMode === 'light' || themeMode === 'dark';
---

{!shouldHide && (
  <button
    id="theme-toggle"
    class="theme-toggle"
    aria-label="Toggle theme"
    title="Toggle theme"
  >
    <span class="sun-icon">
      <Icon name="lucide:sun" size={18} />
    </span>
    <span class="moon-icon">
      <Icon name="lucide:moon" size={18} />
    </span>
  </button>
)}

<style>
  .theme-toggle {
    padding: 0.5rem;
    border-radius: var(--radius);
    color: var(--muted-foreground);
    transition: color 0.2s, background-color 0.2s;
  }

  .theme-toggle:hover {
    color: var(--foreground);
    background-color: var(--accent);
  }

  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: block;
  }

  :global(html.light) .sun-icon {
    display: block;
  }

  :global(html.light) .moon-icon {
    display: none;
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const html = document.documentElement;
      const isDark = html.classList.contains('dark');
      html.classList.remove('light', 'dark');
      html.classList.add(isDark ? 'light' : 'dark');
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
    });
  }
</script>
